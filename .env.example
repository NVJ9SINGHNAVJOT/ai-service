# AI Service Configuration
# Copy this file to .env and adjust values as needed.
#
# All settings below have sensible defaults in app/config.py.
# You only need to set a value here if you want to OVERRIDE the default.

# ── API server (defaults: 0.0.0.0:8000) ─────────────────────────
API_PORT=8000

# ── Inference defaults ───────────────────────────────────────────
# These act as fallbacks if the API caller doesn't specify them.
DEFAULT_MAX_TOKENS=1000
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_REPETITION_PENALTY=1.1

# ── Swagger example models ───────────────────────────────────────
# Pre-filled into the Swagger "Try it out" example bodies (chat
# completions + model load/unload). Set to models you have locally.
# Takes effect on restart.
EXAMPLE_TEXT_MODEL=mlx-community__Meta-Llama-3.1-8B-Instruct-8bit
EXAMPLE_MEDIA_MODEL=mlx-community__gemma-4-e4b-it-bf16

# ── HuggingFace (required for gated/private models) ─────────────
HF_TOKEN=hf_...

# ── Speech models (STT / TTS) ───────────────────────────────────
# STT_MODELS is the allowlist a transcription request may pick from via its
# `model` field (HF repo ids, comma-separated); STT_MODEL is the default when
# the request omits one. `task audio:setup` downloads every model listed here.
# Whisper is multilingual and honors the `language` hint; Parakeet is faster and
# more accurate on English but takes no hint (v2 English-only, v3 multilingual).
STT_MODEL=mlx-community/whisper-large-v3-turbo
STT_MODELS=mlx-community/whisper-large-v3-turbo,mlx-community/parakeet-tdt-0.6b-v2,mlx-community/parakeet-tdt-0.6b-v3
TTS_MODEL=prince-canuma/Kokoro-82M
# Defaults for /v1/audio/speech; both can be overridden per request.
TTS_VOICE=af_heart
TTS_LANG_CODE=a
# Unload an idle speech model after N seconds (0 = keep resident).
STT_IDLE_TIMEOUT_SECONDS=60
TTS_IDLE_TIMEOUT_SECONDS=60

# ── Model cache (where HuggingFace weights download) ─────────────
# Default keeps downloads project-local instead of ~/.cache/huggingface.
HF_CACHE_DIR=models/hf-cache
