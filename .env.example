# AI Service Configuration
# Copy this file to .env and adjust values as needed

# Model storage paths (relative to project root, or absolute)
MODELS_BASE_DIR=models
DOWNLOADED_MODELS_DIR=models/downloaded
CUSTOM_MODELS_DIR=models/custom
MODEL_REGISTRY_FILE=models/registry.json

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Inference defaults
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_REPETITION_PENALTY=1.1

# Optional: default model to load on server start (use sanitized local name)
# DEFAULT_MODEL=mlx-community__Llama-3.2-3B-Instruct-4bit

# HuggingFace token (optional, for gated models)
# HF_TOKEN=hf_...
