# AI Service Configuration
# Copy this file to .env and adjust values as needed.
#
# All settings below have sensible defaults in app/config.py.
# You only need to set a value here if you want to OVERRIDE the default.

# ── API server (defaults: 0.0.0.0:8000) ─────────────────────────
API_PORT=8000

# ── Inference defaults ───────────────────────────────────────────
# These act as fallbacks if the API caller doesn't specify them.
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_REPETITION_PENALTY=1.1

# ── HuggingFace (required for gated/private models) ─────────────
HF_TOKEN=hf_...
